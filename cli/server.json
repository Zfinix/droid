{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Zfinix/droid",
  "title": "Droid",
  "description": "Let any agent use your own Android phone: read the screen, tap, type, and open apps.",
  "websiteUrl": "https://droid.withaster.dev",
  "repository": {
    "url": "https://github.com/Zfinix/droid",
    "source": "github",
    "subfolder": "cli"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@withaster/droid",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "ASTER_DROID_HOME",
          "description": "Where the pairing from `npx -y @withaster/droid pair` is kept. Defaults to ~/.config/aster-droid.",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
